# ============================================================
# Hospital System — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ============================================================


# ── Neo4j AuraDB ────────────────────────────────────────────
NEO4J_URI=neo4j+ssc://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=<your-neo4j-username>
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=<your-neo4j-database-name>


# ── ChromaDB (embedded local) ────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma


# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-<your-anthropic-api-key>


# ── Web Scraper ──────────────────────────────────────────────
GLENEAGLES_BASE_URL=<hospital-base-url>
SCRAPE_HOSPITAL_ID=3
SCRAPE_DELAY_SECONDS=2
SCRAPE_MAX_PAGES=50


# ── Embedding Model (local, no API key needed) ───────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu


# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000


# ── Azure OpenAI (intent router LLM) ────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_AI_API_VERSION=2024-12-01-preview


# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>
MONGODB_DATABASE=hospital_agent
